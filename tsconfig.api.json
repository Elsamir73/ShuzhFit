{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "api/[...path].ts",
    "server/**/*.ts",
    "db/index.ts",
    "db/schema.ts",
    "shared/auth.ts",
    "shared/fitness.ts",
    "shared/program.ts",
    "shared/progression.ts",
    "shared/fallbackVideos.ts"
  ],
  "exclude": ["server/**/*.test.ts"]
}
